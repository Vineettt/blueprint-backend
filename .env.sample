PORT=8787 
 
# Database URLs
DB_AUTH_URL=postgresql://username:password@localhost:5432/auth_db 
DB_PBAC_URL=postgresql://username:password@localhost:5432/pbac_db 

#PGBOSS Configuration
PGBOSS_CONNECTION_STRING=postgresql://username:password@localhost:5432/pgboss_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
 
# CORS Configuration
# Set to your frontend URL, or '*' for any origin (not recommended for production)
CORS_ORIGIN=http://localhost:3000
# CORS_ORIGIN=https://yourdomain.com
# CORS_ORIGIN=* 
 
# Logging
LOG_LEVEL=info
NODE_ENV=development

# Console Logging (development only)
# ENABLE_CONSOLE_LOGS=true
# ENABLE_CONSOLE_LOGS=false

# File Logging
# ENABLE_FILE_LOGS=true
# ENABLE_FILE_LOGS=false

# Cache Configuration
# ENABLE_ROUTE_CACHE=true

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30000

# API Configuration
API_BASE_URL=http://localhost:3000

# Maintenance
MAINTENANCE_MODE=false

# Email Configuration
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@blueprint.com
FRONTEND_URL=http://localhost:3000

# SMTP Settings (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false

# AWS SES Settings (when EMAIL_PROVIDER=ses)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Rate Limiting Configuration
# Options: memory | redis
RATE_LIMIT_STORE=memory
# RATE_LIMIT_STORE=redis

# Redis Configuration (when RATE_LIMIT_STORE=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Redis Cluster Configuration (when REDIS_CLUSTER_ENABLED=true)
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002

#COOKIE ENV
COOKIE_ENV=dev 

# Cookie Domain (for staging and production, set to .blueprint.com)
COOKIE_DOMAIN=.blueprint.com

# Fast API Configuration
JWT_EXPIRES_IN=30EMBEDDING_HOST=0.0.0.0
EMBEDDING_PORT=8000
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_WORKERS=1
EMBEDDING_URL=http://localhost:8000
EMBEDDING_HOST=0.0.0.0
ENVIRONMENT=production
