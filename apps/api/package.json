{
  "name": "@blueprint/api",
  "version": "1.0.0",
  "description": "blueprint backend API",
  "main": "dist/index.js",
  "scripts": {
    "tsc": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "sync:routes": "tsx scripts/sync-routes-auto.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed:roles": "tsx scripts/run-seed.ts",
    "cleanup:tokens": "tsx scripts/cleanup-all-optimized.ts",
    "cleanup:all": "tsx scripts/cleanup-all-optimized.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@blueprint/config": "workspace:*",
    "@blueprint/db": "workspace:*",
    "@blueprint/logger": "workspace:*",
    "@hono/node-server": "^2.0.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/tsyringe": "^1.0.1",
    "@hono/zod-openapi": "^1.3.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.3.6",
    "nodemailer": "^8.0.7",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "ua-parser-js": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.0",
    "@types/reflect-metadata": "^0.1.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.98.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "type": "module"
}
